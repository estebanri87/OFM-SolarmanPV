              </Union>
              <!-- Seriennummer als Text (Byte 38-53), siehe Begruendung beim ParameterType. -->
              <Union SizeInBit="128">
                <Memory CodeSegment="%MID%" Offset="38" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%00005" Name="LoggerSerialText" ParameterType="%AID%_PT-SPVString16" Offset="0" BitOffset="0" Text="Seriennummer" Value="" />
              </Union>
            </Parameters>
            <ParameterRefs>
              <ParameterRef Id="%AID%_UP-%TT%00000_R-%TT%0000001" RefId="%AID%_UP-%TT%00000" />
