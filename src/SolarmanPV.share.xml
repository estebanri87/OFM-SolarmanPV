                <Parameter Id="%AID%_UP-%TT%00000" Name="LoggerIp" ParameterType="%AID%_PT-SPVString32" Offset="0" BitOffset="0" Text="IP-Adresse des Wechselrichters" Value="" />
              </Union>
              <Union SizeInBit="16">
                <Memory CodeSegment="%MID%" Offset="32" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%00001" Name="LoggerPort" ParameterType="%AID%_PT-SPVPort" Offset="0" BitOffset="0" Text="Port" Value="8899" />
              </Union>
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="34" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%00002" Name="SerialMode" ParameterType="%AID%_PT-SPVSerialMode" Offset="0" BitOffset="0" Text="Logger-Seriennummer" Value="0" />
              </Union>
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="35" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%00003" Name="SlaveId" ParameterType="%AID%_PT-SPVSlaveId" Offset="0" BitOffset="0" Text="Modbus-Slave-ID" Value="1" />
              </Union>
              <Union SizeInBit="16">
                <Memory CodeSegment="%MID%" Offset="36" BitOffset="0" />
